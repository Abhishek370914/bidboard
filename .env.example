# Copy to .env.local. With NO payment keys the app runs in DEMO mode
# (bids are simulated and NEVER counted as revenue).
# NEVER paste real keys into chat — put them in your host's env settings
# (Vercel/Netlify project settings) or a local .env.local file only.

# --- Razorpay (the India route — set these to take real money) ---
# Dashboard -> Settings -> API Keys (generate in LIVE mode).
# NOTE: this direct API key pair is separate from the Razorpay app
# connected to a Shopify store.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks: point at https://<your-domain>/api/webhook/razorpay
# events: payment.captured, order.paid — paste that webhook's secret here.
RAZORPAY_WEBHOOK_SECRET=
# Board prices are USD. USD needs "International Payments" enabled on the
# Razorpay account. Domestic-only alternative: INR + a USD->INR rate.
RAZORPAY_CURRENCY=USD
USD_INR_RATE=

# --- Stripe (alternative provider, used only if Razorpay keys are absent) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public base URL of the deployment (used for checkout redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Production database (optional — demo/local runs on a local JSON file)
DATABASE_URL=
